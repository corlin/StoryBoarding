{
  "name": "storyboard-backend-worker",
  "version": "2.3.1",
  "description": "AI Director Storyboarding Edge API on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "test": "node --test tests/*.test.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply storyboard_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply storyboard_db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.1"
  }
}
